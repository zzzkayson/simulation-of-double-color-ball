<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🎱 双色球模拟器</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Microsoft YaHei', 'PingFang SC', sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            min-height: 100vh;
            color: #fff;
            padding: 20px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
        }

        h1 {
            text-align: center;
            font-size: 2.5em;
            margin-bottom: 10px;
            text-shadow: 0 0 20px rgba(255, 215, 0, 0.5);
            background: linear-gradient(90deg, #ff6b6b, #ffd93d, #6bcf7f);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .subtitle {
            text-align: center;
            color: #aaa;
            margin-bottom: 30px;
            font-size: 0.9em;
        }

        .section {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 20px;
            padding: 25px;
            margin-bottom: 20px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .section-title {
            font-size: 1.3em;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .ball-container {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: center;
            margin: 20px 0;
            min-height: 60px;
        }

        .ball {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 1.2em;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            transition: all 0.3s ease;
            animation: popIn 0.5s ease;
        }

        @keyframes popIn {
            0% { transform: scale(0); opacity: 0; }
            80% { transform: scale(1.1); }
            100% { transform: scale(1); opacity: 1; }
        }

        .red-ball {
            background: radial-gradient(circle at 30% 30%, #ff6b6b, #c0392b);
            border: 2px solid #ff6b6b;
        }

        .blue-ball {
            background: radial-gradient(circle at 30% 30%, #3498db, #2980b9);
            border: 2px solid #3498db;
        }

        .ball.hidden-ball {
            background: radial-gradient(circle at 30% 30%, #2c3e50, #1a252f);
            border: 2px solid #34495e;
            color: transparent;
            animation: none;
        }

        .ball.reveal {
            animation: flipReveal 0.6s ease;
        }

        @keyframes flipReveal {
            0% { transform: rotateY(0deg); }
            50% { transform: rotateY(90deg); }
            100% { transform: rotateY(0deg); }
        }

        .input-section {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 10px;
            margin: 20px 0;
        }

        .ball-input {
            width: 100%;
            aspect-ratio: 1;
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, 0.3);
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            text-align: center;
            font-size: 1.2em;
            font-weight: bold;
            outline: none;
            transition: all 0.3s;
        }

        .ball-input:focus {
            border-color: #ffd93d;
            background: rgba(255, 255, 255, 0.2);
            transform: scale(1.1);
        }

        .ball-input.red {
            border-color: #ff6b6b;
        }

        .ball-input.blue {
            border-color: #3498db;
        }

        .ball-input::placeholder {
            color: rgba(255, 255, 255, 0.3);
            font-size: 0.8em;
        }

        .btn {
            padding: 12px 30px;
            border: none;
            border-radius: 25px;
            font-size: 1em;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
            margin: 5px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }

        .btn-primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
        }

        .btn-danger {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: #fff;
        }

        .btn-success {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: #fff;
        }

        .btn-group {
            display: flex;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
            margin: 20px 0;
        }

        .result-box {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 15px;
            padding: 20px;
            margin-top: 20px;
            text-align: center;
            display: none;
        }

        .result-box.show {
            display: block;
            animation: slideDown 0.5s ease;
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .prize-text {
            font-size: 1.5em;
            font-weight: bold;
            margin: 10px 0;
        }

        .prize-1 { color: #ffd700; text-shadow: 0 0 10px rgba(255, 215, 0, 0.5); }
        .prize-2 { color: #ff6b6b; }
        .prize-3 { color: #ffa502; }
        .prize-4 { color: #2ed573; }
        .prize-5 { color: #1e90ff; }
        .prize-6 { color: #a29bfe; }
        .no-prize { color: #b2bec3; }

        .stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 15px;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
            padding: 15px;
            text-align: center;
        }

        .stat-number {
            font-size: 2em;
            font-weight: bold;
            color: #ffd93d;
        }

        .stat-label {
            color: #aaa;
            font-size: 0.9em;
            margin-top: 5px;
        }

        .history {
            max-height: 200px;
            overflow-y: auto;
            margin-top: 15px;
        }

        .history-item {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.85em;
        }

        .history-balls {
            display: flex;
            gap: 5px;
        }

        .history-balls .mini-ball {
            width: 25px;
            height: 25px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7em;
            font-weight: bold;
        }

        .mini-red {
            background: #c0392b;
        }

        .mini-blue {
            background: #2980b9;
        }

        .rules {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 10px;
            padding: 15px;
            margin-top: 15px;
            font-size: 0.85em;
            line-height: 1.8;
        }

        .rules h3 {
            margin-bottom: 10px;
            color: #ffd93d;
        }

        .rules table {
            width: 100%;
            border-collapse: collapse;
        }

        .rules td, .rules th {
            padding: 5px 10px;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .rules th {
            color: #ffd93d;
        }

        .mask-text {
            color: #666;
            font-style: italic;
        }

        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.3);
        }

        @media (max-width: 600px) {
            .input-section {
                grid-template-columns: repeat(4, 1fr);
            }
            .ball-input:nth-child(5),
            .ball-input:nth-child(6) {
                grid-column: span 2;
            }
            .ball-input:nth-child(7) {
                grid-column: span 4;
                max-width: 50%;
                margin: 0 auto;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🎱 双色球模拟器</h1>
        <p class="subtitle">先选号，再揭晓 · 试试你的手气</p>

        <!-- 用户投注区 -->
        <div class="section">
            <div class="section-title">🎯 选择你的幸运号码</div>
            <div class="input-section">
                <input type="number" class="ball-input red" placeholder="红1" id="r1" min="1" max="33">
                <input type="number" class="ball-input red" placeholder="红2" id="r2" min="1" max="33">
                <input type="number" class="ball-input red" placeholder="红3" id="r3" min="1" max="33">
                <input type="number" class="ball-input red" placeholder="红4" id="r4" min="1" max="33">
                <input type="number" class="ball-input red" placeholder="红5" id="r5" min="1" max="33">
                <input type="number" class="ball-input red" placeholder="红6" id="r6" min="1" max="33">
                <input type="number" class="ball-input blue" placeholder="蓝" id="b1" min="1" max="16">
            </div>
            <div class="btn-group">
                <button class="btn btn-success" onclick="quickPick()">⚡ 机选一注</button>
                <button class="btn btn-danger" onclick="clearInputs()">🗑️ 清空</button>
            </div>
        </div>

        <!-- 开奖号码区（先隐藏） -->
        <div class="section">
            <div class="section-title">🎰 本期开奖号码 <span style="color: #ffd93d; font-size: 0.8em;">（选号后揭晓）</span></div>
            <div class="ball-container" id="drawBalls">
                <!-- 初始显示7个问号球 -->
            </div>
        </div>

        <!-- 操作按钮 -->
        <div class="btn-group">
            <button class="btn btn-primary" id="checkBtn" onclick="checkResult()">🔍 查看中奖结果</button>
            <button class="btn btn-primary" onclick="newRound()">🔄 再来一局</button>
        </div>

        <!-- 结果显示区 -->
        <div class="section result-box" id="resultBox">
            <div class="section-title">🏆 开奖结果</div>
            <div id="resultContent"></div>
            <div class="stats">
                <div class="stat-card">
                    <div class="stat-number" id="redCount">0</div>
                    <div class="stat-label">红球命中</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number" id="blueCount">0</div>
                    <div class="stat-label">蓝球命中</div>
                </div>
            </div>
        </div>

        <!-- 历史记录 -->
        <div class="section">
            <div class="section-title">📜 投注历史</div>
            <div class="history" id="history">
                <div style="color: #666; text-align: center; padding: 20px;">暂无记录</div>
            </div>
        </div>

        <!-- 中奖规则 -->
        <div class="section">
            <div class="section-title">📋 中奖规则</div>
            <div class="rules">
                <table>
                    <tr>
                        <th>奖级</th>
                        <th>红球</th>
                        <th>蓝球</th>
                        <th>奖金</th>
                    </tr>
                    <tr><td>一等奖</td><td>6</td><td>1</td><td>1000万</td></tr>
                    <tr><td>二等奖</td><td>6</td><td>0</td><td>500万</td></tr>
                    <tr><td>三等奖</td><td>5</td><td>1</td><td>3000元</td></tr>
                    <tr><td>四等奖</td><td>5/4</td><td>0/1</td><td>200元</td></tr>
                    <tr><td>五等奖</td><td>4/3</td><td>0/1</td><td>10元</td></tr>
                    <tr><td>六等奖</td><td>2/1/0</td><td>1</td><td>5元</td></tr>
                </table>
            </div>
        </div>
    </div>

    <script>
        // ==================== 核心逻辑 ====================
        
        let currentDraw = [];      // 当前开奖号码（已生成但隐藏）
        let isRevealed = false;    // 是否已揭晓
        let historyData = [];      // 历史记录

        function randomInt(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function contains(arr, num, count) {
            for (let i = 0; i < count; i++) {
                if (arr[i] === num) return true;
            }
            return false;
        }

        function creatnum() {
            let arr = new Array(7);
            for (let i = 0; i < 6; ) {
                let rednumber = randomInt(1, 33);
                if (!contains(arr, rednumber, i)) {
                    arr[i] = rednumber;
                    i++;
                }
            }
            arr[6] = randomInt(1, 16);
            return arr;
        }

        function userinputnum() {
            let arr = new Array(7);
            let inputs = ['r1','r2','r3','r4','r5','r6','b1'];
            
            for (let i = 0; i < 6; i++) {
                let val = parseInt(document.getElementById(inputs[i]).value);
                if (isNaN(val) || val < 1 || val > 33) {
                    alert(`第${i+1}个红球输入无效！请输入1-33之间的数字`);
                    return null;
                }
                if (contains(arr, val, i)) {
                    alert(`第${i+1}个红球重复了！`);
                    return null;
                }
                arr[i] = val;
            }
            
            let blue = parseInt(document.getElementById('b1').value);
            if (isNaN(blue) || blue < 1 || blue > 16) {
                alert('蓝球输入无效！请输入1-16之间的数字');
                return null;
            }
            arr[6] = blue;
            return arr;
        }

        function checkWin(userArr, drawArr) {
            let redcount = 0;
            let bluecount = 0;

            for (let i = 0; i < 6; i++) {
                let rednumber = userArr[i];
                for (let j = 0; j < 6; j++) {
                    if (rednumber === drawArr[j]) {
                        redcount++;
                        break;
                    }
                }
            }

            if (userArr[6] === drawArr[6]) {
                bluecount++;
            }

            return { redcount, bluecount };
        }

        function getPrize(redcount, bluecount) {
            if (redcount === 6 && bluecount === 1) {
                return { level: 1, text: '恭喜你，中了1000万！', class: 'prize-1' };
            } else if (redcount === 6 && bluecount === 0) {
                return { level: 2, text: '恭喜你，中奖500万！', class: 'prize-2' };
            } else if (redcount === 5 && bluecount === 1) {
                return { level: 3, text: '恭喜你，中奖3000元！', class: 'prize-3' };
            } else if ((redcount === 5 && bluecount === 0) || (redcount === 4 && bluecount === 1)) {
                return { level: 4, text: '恭喜你，中奖200元！', class: 'prize-4' };
            } else if ((redcount === 4 && bluecount === 0) || (redcount === 3 && bluecount === 1)) {
                return { level: 5, text: '恭喜你，中奖10元！', class: 'prize-5' };
            } else if ((redcount === 2 && bluecount === 1) || (redcount === 1 && bluecount === 1) || (redcount === 0 && bluecount === 1)) {
                return { level: 6, text: '恭喜你，中奖5元！', class: 'prize-6' };
            } else {
                return { level: 0, text: '谢谢参与，祝您下次好运！', class: 'no-prize' };
            }
        }

        // ==================== 界面交互 ====================

        // 渲染隐藏球（问号）
        function renderHiddenBalls() {
            let container = document.getElementById('drawBalls');
            container.innerHTML = '';
            for (let i = 0; i < 7; i++) {
                let ball = document.createElement('div');
                ball.className = 'ball hidden-ball';
                ball.id = `draw-ball-${i}`;
                ball.textContent = '?';
                container.appendChild(ball);
            }
        }

        // 揭晓开奖号码（带动画）
        function revealBalls() {
            let container = document.getElementById('drawBalls');
            container.innerHTML = '';
            
            currentDraw.forEach((num, index) => {
                let ball = document.createElement('div');
                ball.className = `ball ${index < 6 ? 'red-ball' : 'blue-ball'} reveal`;
                ball.style.animationDelay = `${index * 0.15}s`;
                ball.textContent = num.toString().padStart(2, '0');
                container.appendChild(ball);
            });
            
            isRevealed = true;
        }

        // 机选一注
        function quickPick() {
            let nums = creatnum();
            let reds = nums.slice(0, 6).sort((a, b) => a - b);
            let blue = nums[6];
            
            document.getElementById('r1').value = reds[0];
            document.getElementById('r2').value = reds[1];
            document.getElementById('r3').value = reds[2];
            document.getElementById('r4').value = reds[3];
            document.getElementById('r5').value = reds[4];
            document.getElementById('r6').value = reds[5];
            document.getElementById('b1').value = blue;
        }

        // 清空输入
        function clearInputs() {
            ['r1','r2','r3','r4','r5','r6','b1'].forEach(id => {
                document.getElementById(id).value = '';
            });
        }

        // 查看中奖结果（核心：先验证输入，再揭晓号码）
        function checkResult() {
            // 1. 先获取用户输入，验证是否填完
            let userArr = userinputnum();
            if (!userArr) return;  // 输入无效，直接返回

            // 2. 揭晓开奖号码（此时用户已经选完号，无法更改）
            revealBalls();

            // 3. 计算中奖结果
            let result = checkWin(userArr, currentDraw);
            let prize = getPrize(result.redcount, result.bluecount);

            // 4. 显示结果
            document.getElementById('redCount').textContent = result.redcount;
            document.getElementById('blueCount').textContent = result.bluecount;
            
            let resultHTML = `
                <div class="prize-text ${prize.class}">${prize.text}</div>
                <div style="color: #aaa; margin-top: 10px;">
                    您的号码：${userArr.slice(0,6).join(' ')} + ${userArr[6]}<br>
                    开奖号码：${currentDraw.slice(0,6).join(' ')} + ${currentDraw[6]}
                </div>
            `;
            document.getElementById('resultContent').innerHTML = resultHTML;
            document.getElementById('resultBox').classList.add('show');

            // 5. 添加到历史
            addHistory(userArr, currentDraw, prize);
            
            // 6. 禁用查看按钮，防止重复点击
            document.getElementById('checkBtn').disabled = true;
        }

        // 再来一局（重置所有状态）
        function newRound() {
            // 生成新的开奖号码（仍然隐藏）
            currentDraw = creatnum();
            isRevealed = false;
            
            // 恢复显示问号球
            renderHiddenBalls();
            
            // 清空结果区
            document.getElementById('resultBox').classList.remove('show');
            document.getElementById('resultContent').innerHTML = '';
            document.getElementById('redCount').textContent = '0';
            document.getElementById('blueCount').textContent = '0';
            
            // 启用查看按钮
            document.getElementById('checkBtn').disabled = false;
            
            // 可选：清空用户输入（注释掉则保留上次号码）
            // clearInputs();
        }

        function addHistory(user, draw, prize) {
            historyData.unshift({ user, draw, prize, time: new Date().toLocaleString() });
            renderHistory();
        }

        function renderHistory() {
            let container = document.getElementById('history');
            if (historyData.length === 0) {
                container.innerHTML = '<div style="color: #666; text-align: center; padding: 20px;">暂无记录</div>';
                return;
            }

            container.innerHTML = historyData.map(item => `
                <div class="history-item">
                    <div>
                        <div style="color: #aaa; font-size: 0.75em; margin-bottom: 4px;">${item.time}</div>
                        <div class="history-balls">
                            ${item.user.slice(0,6).map(n => `<div class="mini-ball mini-red">${n}</div>`).join('')}
                            <div class="mini-ball mini-blue">${item.user[6]}</div>
                        </div>
                    </div>
                    <div style="text-align: right;">
                        <div style="color: ${item.prize.level > 0 ? '#ffd93d' : '#b2bec3'}; font-weight: bold;">
                            ${item.prize.level > 0 ? `中${item.prize.level}等奖` : '未中奖'}
                        </div>
                        <div style="color: #666; font-size: 0.75em;">${item.prize.text}</div>
                    </div>
                </div>
            `).join('');
        }

        // 页面加载时初始化
        window.onload = function() {
            currentDraw = creatnum();  // 生成开奖号码（但不显示）
            renderHiddenBalls();        // 显示7个问号球
        };
    </script>
</body>
</html>
